# Copy this file to <workspace>/local/.env (outside the repository) and fill it in.
# Model provider: fill in ONE of these two. OpenRouter is what the submitted
# run used; with only a Featherless key, setup switches every seat to Featherless.
OPENROUTER_API_KEY=
FEATHERLESS_API_KEY=
# BAND user API key, used once by setup to register the four seats.
BAND_USER_API_KEY=
